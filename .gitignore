# Firefox-Legacy — paths that must never be committed.
#
# Build output (reproducible, tens of GB, well over GitHub file-size limits)
# ---------------------------------------------------------------
161.0a1/obj-highsierra/
161.0a1/obj-highsierra-nehalem/
161.0a1/obj-highsierra-penryn/

# Local libc++ 19 build (~2 GB, reproducible from Mozilla's bootstrap toolchain)
# ---------------------------------------------------------------
toolchain-build/

# PGO profile data (regenerated per build, ~1 GB when present)
# ---------------------------------------------------------------
*.profraw
*.profdata
161.0a1/default_*_random_*.profraw
161.0a1/*.profraw

# Mozilla's local workspace cache (lives under project tree if any is created)
# ---------------------------------------------------------------
.mozbuild/
.cache/
.mach_build_cache/

# Python virtualenvs occasionally created by ./mach commands
# ---------------------------------------------------------------
.venv/
venv/
__pycache__/
*.pyc
*.pyo

# Build / test artefacts dropped under the source tree
# ---------------------------------------------------------------
161.0a1/testing/mozbase/mozinfo.json
161.0a1/*.log
*.log
161.0a1/tmp*/

# User-specific editor / IDE state
# ---------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~

# macOS filesystem metadata
# ---------------------------------------------------------------
.DS_Store
._*
.Spotlight-V100
.Trashes
.fseventsd
.TemporaryItems

# Icon pipeline intermediates that are regenerated by scripts
# (keeps the source PNGs and the final .icns, drops the staging iconset)
# ---------------------------------------------------------------
icon/sierrafox.iconset/

# Temporary scratch files
# ---------------------------------------------------------------
/tmp/
scratch/

# Release artifacts (uploaded to GitHub Releases, not versioned in the repo)
# ---------------------------------------------------------------
dist/
161.0a1/libgkrust.a.lto.o/

# Local-only overrides, never committed
CLAUDE.local.md
