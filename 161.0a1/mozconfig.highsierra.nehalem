# Mozconfig for the Firefox-Legacy High Sierra port — Nehalem compatibility build.
#
# Lowers the CPU floor from Westmere (SSE4.2 + AES-NI + PCLMULQDQ) to Nehalem
# (SSE4.2 only), extending compatibility to Mac Pro 4,1 and the Nehalem Core
# i5/i7 iMacs (late-2009 and mid-2010 i5/i7 variants) that lack AES-NI.
#
# PGO uses a Nehalem-specific merged.profdata produced by running the full
# three-phase workflow against this variant (instrumented build →
# profileserver.py → llvm-profdata merge → optimised rebuild consuming
# obj-highsierra-nehalem/merged.profdata). The Westmere merged.profdata
# cannot be reused here — different -march produces different IR hashes and
# consuming the mismatched profile would collapse to default heuristics.
#
# All other patches, SDK, libc++, and build flags match the Westmere mozconfig.

ac_add_options --target=x86_64-apple-darwin
ac_add_options --with-macos-sdk=/Applications/Xcode-9.4.1.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX10.13.sdk
ac_add_options --enable-macos-target=10.13

ac_add_options --disable-updater

export MACOSX_DEPLOYMENT_TARGET=10.13

# Link against local libc++ 19, rpath set to @executable_path so the dylib
# is looked up next to firefox at Contents/MacOS/. See mozconfig.highsierra
# for the full rationale and the post-build libc++ copy step.
export LDFLAGS="-L$HOME/.mozbuild/clang/lib -Wl,-rpath,@executable_path -Wl,-undefined,dynamic_lookup"
export HOST_LDFLAGS="-L$HOME/.mozbuild/clang/lib -Wl,-rpath,$HOME/.mozbuild/clang/lib -Wl,-undefined,dynamic_lookup"

mk_add_options MOZ_OBJDIR=@TOPSRCDIR@/../../obj-highsierra-nehalem

ac_add_options --enable-lto=thin

# PGO phase 3: optimised build consuming merged.profdata from phase 2.
# obj-highsierra-nehalem/merged.profdata comes from running an instrumented
# build under profileserver.py and merging the resulting .profraw files with
# llvm-profdata. Bare --enable-profile-use (no =cross) matches the bare
# --enable-profile-generate used in phase 1 — Rust is skipped on both
# sides because clang (LLVM 22.1.8) and rustc (LLVM 23.1.1) produce
# incompatible PGO ABIs.
ac_add_options --enable-profile-use
ac_add_options --with-pgo-profile-path=@TOPSRCDIR@/../../obj-highsierra-nehalem/merged.profdata

# Target Nehalem: SSE4.2, POPCNT, but no AES-NI, no PCLMULQDQ.
# Covers Mac Pro 4,1, iMac late-2009/mid-2010 Core i5/i7 (Lynnfield),
# and everything that passes the Westmere baseline (since Nehalem is a
# strict subset of what later architectures provide).
#
# Also remap build-host paths to opaque placeholders so no "/Users/<name>" or
# "/Volumes/<disk>" leaks into shipped binaries. Rust's panic!()/file!() and
# C++ debug info otherwise embed absolute source paths as literal strings.
PROJ_ROOT="$(cd "$PWD/../.." && pwd)"
export CFLAGS="$CFLAGS -march=nehalem -ffile-prefix-map=$PROJ_ROOT=/sierra-fox -ffile-prefix-map=$PWD=/sierra-fox-build -ffile-prefix-map=$HOME=/home"
export CXXFLAGS="$CXXFLAGS -march=nehalem -ffile-prefix-map=$PROJ_ROOT=/sierra-fox -ffile-prefix-map=$PWD=/sierra-fox-build -ffile-prefix-map=$HOME=/home"
export RUSTFLAGS="$RUSTFLAGS -C target-cpu=nehalem --remap-path-prefix=$PROJ_ROOT=/sierra-fox --remap-path-prefix=$PWD=/sierra-fox-build --remap-path-prefix=$HOME=/home"
